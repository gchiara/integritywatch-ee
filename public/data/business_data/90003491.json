                "kirje_id": 3656180,
                "lopp_kpv": null,
                "sisu": "luua rahvakultuuri ja seltsielu viljelemiseks ja arendamiseks vajalikud (materiaaalsed ja organisatsioonilised) võimalused;"
            },
