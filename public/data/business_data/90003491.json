                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 3656179,
                "lopp_kpv": null,
                "sisu": "korraldada mistahes teatrikunsti ja laiemalt kultuuri populariseerivaid üritusi lisaks etendustele: kino, festivalid, koolitused, seminarid, erinevaid kunstialasid sünteesivad ettevõtmised jms;"
            },
            {
                "algus_kpv": "09.11.2004",
