                "kaardi_piirkond": 4,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 3656177,
                "lopp_kpv": null,
                "sisu": "tekitada dialoog publikuga läbi sotsiaalselt oluliste ja intrigeerivate teemade käsitlemise lavastustes;"
            },
            {
                "algus_kpv": "09.11.2004",
                "kaardi_nr": 1,
                "kaardi_piirkond": 4,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 3656176,
                "lopp_kpv": null,
                "sisu": "omada tasakaalustatud repertuaari, mis on suunatud erinevatele vaatajate sihtgruppidele;"
            },
