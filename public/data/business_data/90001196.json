                "algus_kpv": "03.01.2011",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 8,
                "kirje_id": 3971120,
                "lopp_kpv": null,
                "sisu": "loodushariduse arendamine metsa majandamise vallas saadud kogemuste ja metsade loodusväärtuste tutvustamiseks,sh plaanistatud õpperadade süsteemi toimimine ning loodushariduskeskuse rajamine."
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298520,
                "lopp_kpv": null,
                "sisu": "Sihtasutuse piirides sotsiaalsfääri arendamine."
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298519,
                "lopp_kpv": null,
                "sisu": "Metsanduslike nõuannete ja konsultatsioonide andmine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298518,
                "lopp_kpv": null,
                "sisu": "Koostöös teaduskonnaga kirjastustegevuse arendamine ja toetamine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298517,
                "lopp_kpv": null,
                "sisu": "Taimlamajanduse arendamine koostöös metsandusteaduskonnaga ja taimlatest saadava istutusmaterjali realiseerimine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298516,
                "lopp_kpv": null,
                "sisu": "Ökoturismi ja jahinduse arendamine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298515,
                "lopp_kpv": null,
                "sisu": "Õppe-ja katsetustegevuseks vajalike kulude katmine asutuse majandamisest saadud tuludest,teaduskonna varustamine õppeotstarbelise puiduga;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298514,
                "lopp_kpv": null,
                "sisu": "Loodussäästlike tehnoloogiate ja metsatehnika katsetamine ja rakendamine,puidu ratsionaalse ja kompleksse kasutamise tehnoloogiate väljatöötamine ja rakendamine,metsast saadava puidu realiseerimine võimalikult kohapeal ümbertöötatud kujul;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298513,
                "lopp_kpv": null,
                "sisu": "Metsanduslike konverentside,nõupidamiste,seminaride läbiviimise võimaldamine ja abistamine,metsamajandusteaduskonnaga seotud isikute ja delegatsioonide majutamine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298512,
                "lopp_kpv": null,
                "sisu": "Teadus-ja tootmiskatsete ning   praktilise koostöö arendamine metsandusteaduskonna,Eesti metsanduslike asutuste ja välismaiste metsanduslike õppe-ja uurimisasutustega;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298511,
                "lopp_kpv": null,
                "sisu": "Eesti Põllumajandusülikooli metsandusteaduskonna õppebaasiks olemine ja selle arendamine ,õppepraktikate läbiviimiseks olmetingimuste tagamine, EestiPõllumajandusülikooli teiste teaduskondade õppepraktikate läbiviimise soodustamine;"
            },
            {
                "algus_kpv": "10.12.1997",
                "kaardi_nr": 1,
                "kaardi_piirkond": 2,
                "kaardi_tyyp": "SA",
                "kande_nr": 1,
                "kirje_id": 2298509,
                "lopp_kpv": null,
                "sisu": "Baasiks olemine metsamajandusliku uurimis-ja katsetegevuse korraldamisel ning katsealade rajamine,säilitamine,hooldamine ja arendamine Eesti Põllumajandusülikooli metsateaduskonna juhtimisel ja kaasabil,olles baasiks üliõpilas-ja teadustööde materjalide kogumisel;"
            }
        ],
