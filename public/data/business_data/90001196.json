                "kirje_id": 3971119,
                "lopp_kpv": null,
                "sisu": "metsapindala ja metsaelustiku mitmekesisuse säilitamine ning metsakoosluste kaitse,metsade säästev majandamine ühtlase,pideva ja kauakestva kasutamise planeerimisega"
            },
